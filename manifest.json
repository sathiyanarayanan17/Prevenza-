{
  "manifest_version": 3,
  "name": "Prevenza: Scam Guard",
  "short_name": "Prevenza",
  "version": "0.1.0",
  "description": "A friendly, privacy-first scam guard. Step 1 foundation: no scam detection yet. Runs on your device and sends nothing anywhere.",
  "minimum_chrome_version": "110",
  "icons": {
    "16": "assets/icons/icon16.png",
    "48": "assets/icons/icon48.png",
    "128": "assets/icons/icon128.png"
  },
  "action": {
    "default_title": "Prevenza: Scam Guard",
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "assets/icons/icon16.png",
      "48": "assets/icons/icon48.png",
      "128": "assets/icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "src/background/service-worker.js"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["src/shared/constants.js", "src/shared/settings.js", "src/shared/mascot.js", "src/content/content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "options_ui": {
    "page": "src/settings/settings.html",
    "open_in_tab": true
  },
  "permissions": ["storage"],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'; form-action 'none'; connect-src 'none'; img-src 'self' data:; style-src 'self'"
  }
}
