{
  "name": "prevenza-scam-guard",
  "version": "0.1.0",
  "private": true,
  "description": "Prevenza: Scam Guard. Offline, privacy-first Chrome extension (Manifest V3) that checks links, messages, UPI payments and screenshots.",
  "scripts": {
    "icons": "node scripts/make-icons.js",
    "test": "node --test \"test/*.test.js\"",
    "test:e2e": "node e2e/run.js",
    "test:e2e:web": "node e2e/web.js",
    "web": "node scripts/serve-web.js",
    "ocr:assets": "node scripts/make-ocr-assets.js",
    "audit:detection": "node scripts/detection-check.js",
    "eval:holdout": "node scripts/evaluate-holdout.js"
  },
  "devDependencies": {
    "@tesseract.js-data/eng": "1.0.0",
    "@tesseract.js-data/hin": "1.0.0",
    "@tesseract.js-data/tam": "1.0.0",
    "fast-check": "^4.11.0",
    "jsqr": "1.4.0",
    "playwright-core": "^1.65.1",
    "pngjs": "^7.0.0",
    "qrcode": "1.5.4",
    "tesseract.js": "7.0.0"
  }
}
